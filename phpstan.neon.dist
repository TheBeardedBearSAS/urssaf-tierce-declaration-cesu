includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    # phpstan-strict-rules, -deprecation-rules, -phpunit, -symfony, -doctrine,
    # shipmonk/phpstan-rules, ergebnis/phpstan-rules and tomasvotruba/type-coverage
    # are registered automatically by phpstan/extension-installer.

parameters:
    level: max
    # Analyse against the lowest supported PHP version (composer "php": ">=8.2"), whatever the runtime: on PHP 8.3+
    # PHPStan would otherwise demand typed class constants, a PHP 8.3 feature the package cannot use.
    phpVersion: 80200
    paths:
        - src
        - tests
        - bin
    tmpDir: var/phpstan
    checkMissingCallableSignature: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    checkUninitializedProperties: true
    checkImplicitMixed: true
    checkBenevolentUnionTypes: true
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: false

    type_coverage:
        return: 100
        param: 100
        property: 100
        # Typed class constants are a PHP 8.3 feature and the package supports PHP 8.2 (composer "php": ">=8.2"): the
        # plugin skips this check on PHP 8.2 and would demand them on PHP 8.3+, which breaks `make ci PHP_VERSION=8.4`.
        # Disabled so that the gate is identical on every supported version (ADR 0000).
        constant: 0

    ergebnis:
        # AbstractBundle::loadExtension/prependExtension and CompilerPassInterface::process impose ContainerBuilder parameters.
        noParameterWithContainerTypeDeclaration:
            enabled: false
        noExtends:
            classesAllowedToBeExtended:
                - DomainException
                - LogicException
                - RuntimeException
                # Base class of every domain exception (violation code + params), ADR 0000 §13.
                - TheBeardedBear\UrssafTierceDeclarationCesu\Domain\Exception\DomainException
                # Common properties of the public integration events (scalar, readonly, rebuilt by named arguments).
                - TheBeardedBear\UrssafTierceDeclarationCesu\Contract\Event\IntegrationEvent
                # Framework extension points without an interface alternative (bridges only).
                - Doctrine\DBAL\Types\Type
                - Symfony\Component\HttpKernel\Bundle\AbstractBundle
                - Symfony\Component\Console\Command\Command
                - Symfony\Component\HttpKernel\Kernel
        # Doctrine generates lazy-loading proxies by extending the mapped entities, so the entities cannot be final;
        # they are final by convention (@final phpdoc). Embeddables are never proxied and stay final.
        final:
            classesNotRequiredToBeAbstractOrFinal:
                - TheBeardedBear\UrssafTierceDeclarationCesu\Domain\Employer\EmployerAccount
                - TheBeardedBear\UrssafTierceDeclarationCesu\Domain\Mandate\Mandate
                - TheBeardedBear\UrssafTierceDeclarationCesu\Domain\Declaration\DeclarationRecord
                # Doctrine bridge entities (ADR 0014): read-only, written with DBAL, proxied like the aggregates.
                - TheBeardedBear\UrssafTierceDeclarationCesu\Bridge\Doctrine\Entity\OutboxMessage
                - TheBeardedBear\UrssafTierceDeclarationCesu\Bridge\Doctrine\Entity\ActiveMandate
        # Disabled rules (DDD value objects / domain model), each one justified:
        # Optional value-object arguments and "withX" factories legitimately default (e.g. currency, locale).
        noConstructorParameterWithDefaultValue:
            enabled: false
        # Optional domain concepts (e.g. end date, external identifier) are modelled as nullable parameters.
        noParameterWithNullableTypeDeclaration:
            enabled: false
        # Repositories/finders return ?Entity for "not found" rather than throwing.
        noNullableReturnTypeDeclaration:
            enabled: false

    ignoreErrors:
        # Optional settings of ApiConfiguration (request-id / application-id headers, base URI override) default to null
        # = not configured, so that `new ApiConfiguration($environment)` works: public constructor with optional defaulted
        # parameters, like the reference ApiConfiguration (lot 3 lead decision).
        -
            identifier: ergebnis.noParameterWithNullDefaultValue
            path: src/Infrastructure/Urssaf/ApiConfiguration.php
        # Doctrine optimistic-lock token, read and written by the ORM through reflection (lot 7 lead decision 1): not a
        # domain concept, so the aggregates expose no accessor.
        -
            identifier: property.onlyWritten
            paths:
                - src/Domain/Employer/EmployerAccount.php
                - src/Domain/Mandate/Mandate.php
                - src/Domain/Declaration/DeclarationRecord.php

    shipmonkRules:
        enableAllRules: true


<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <embeddable name="TheBeardedBear\UrssafTierceDeclarationCesu\Domain\Mandate\MandateTimeline">
        <field name="notifiedAt" type="urssaf_cesu_instant" column="notified_at"/>
        <field name="confirmedAt" type="urssaf_cesu_instant" column="confirmed_at" nullable="true"/>
        <field name="cancelledAt" type="urssaf_cesu_instant" column="cancelled_at" nullable="true"/>
        <field name="updatedAt" type="urssaf_cesu_instant" column="updated_at"/>
    </embeddable>
</doctrine-mapping>

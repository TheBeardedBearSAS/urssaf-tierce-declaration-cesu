<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <embeddable name="TheBeardedBear\UrssafTierceDeclarationCesu\Domain\Declaration\DeclarationStatus">
        <field name="state" type="string" column="state" length="32" enum-type="TheBeardedBear\UrssafTierceDeclarationCesu\Domain\Declaration\DeclarationState"/>
        <field name="attempts" type="integer" column="submission_attempts"/>
        <field name="lastAttemptAt" type="urssaf_cesu_instant" column="last_attempt_at" nullable="true"/>
        <field name="errors" type="urssaf_cesu_submission_errors" column="errors"/>
        <field name="declarationId" type="urssaf_cesu_declaration_id" column="declaration_id" length="64" nullable="true"/>
        <field name="result" type="urssaf_cesu_declaration_result" column="result" nullable="true"/>
        <field name="outcomeUnknownReason" type="string" column="outcome_unknown_reason" length="32" nullable="true" enum-type="TheBeardedBear\UrssafTierceDeclarationCesu\Domain\Declaration\OutcomeUnknownReason"/>
        <field name="updatedAt" type="urssaf_cesu_instant" column="updated_at"/>
    </embeddable>
</doctrine-mapping>

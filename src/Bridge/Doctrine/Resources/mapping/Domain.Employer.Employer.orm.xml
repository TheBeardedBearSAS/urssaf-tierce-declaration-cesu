<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- Identification of an employer in every call: Cesu number and birth date (personal data, ADR 0007: its own type,
         so that an application can encrypt it). Embedded by the employer account and the mandate. -->
    <embeddable name="TheBeardedBear\UrssafTierceDeclarationCesu\Domain\Employer\Employer">
        <field name="cesuNumber" type="urssaf_cesu_cesu_number" column="cesu_number" length="14"/>
        <field name="birthDate" type="urssaf_cesu_birth_date" column="birth_date"/>
    </embeddable>
</doctrine-mapping>

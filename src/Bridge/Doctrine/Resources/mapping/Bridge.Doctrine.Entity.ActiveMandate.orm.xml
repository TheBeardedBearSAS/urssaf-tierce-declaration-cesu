<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- Key table of the active mandates (ADR 0006): one row per non-cancelled mandate, rewritten with DBAL by the mandate
         repository in the transaction of every save. Its primary key (tenant, Cesu number) is the "one active mandate per
         employer" constraint, portable to every platform (a partial unique index is not). -->
    <entity name="TheBeardedBear\UrssafTierceDeclarationCesu\Bridge\Doctrine\Entity\ActiveMandate" table="urssaf_cesu_active_mandates" read-only="true">
        <unique-constraints>
            <unique-constraint name="uniq_urssaf_cesu_active_mandate_id" columns="mandate_id"/>
        </unique-constraints>
        <id name="tenantId" type="urssaf_cesu_tenant_id" column="tenant_id" length="64"/>
        <id name="cesuNumber" type="urssaf_cesu_cesu_number" column="cesu_number" length="14"/>
        <field name="mandateId" type="urssaf_cesu_mandate_id" column="mandate_id" length="64"/>
    </entity>
</doctrine-mapping>

{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "phpUnit": {
        "configDir": "."
    },
    "testFrameworkOptions": "--testsuite=unit,functional",
    "tmpDir": "var/infection-tmp",
    "logs": {
        "text": "var/infection/infection.log",
        "summary": "var/infection/summary.log",
        "json": "var/infection/infection.json",
        // Full mutation report of main on the Stryker Dashboard (needs STRYKER_DASHBOARD_API_KEY, set in CI only).
        "stryker": {
            "report": "/^main$/"
        }
    },
    "mutators": {
        "@default": true
    },
    // Deviation from the reference (30 s): Infection *skips* (never runs) a mutant whose covering tests take longer than
    // this limit in total, and still reports MSI 100 %. Widely used value objects are covered by the functional suites,
    // so 30 s left 10 mutants untested on the CI runners. A higher limit makes the gate stricter, not weaker;
    // `make infection` and the CI job also fail when any mutant is skipped.
    "timeout": 180,
    // A timed-out mutant is not a verdict (the covering tests never finished), so it counts as escaped and breaks the
    // MSI gate. The code is written so that every mutant terminates (no unbounded loop, no blocking call), and
    // `make infection` and the CI job also fail on any "Timed Out" or "Syntax Errors" mutant.
    "timeoutsAsEscaped": true,
    // `make infection` and the CI job also pass --only-covering-test-cases (command line only): each mutant runs just the
    // test cases that cover its line instead of the whole test files, so a mutant never waits on dozens of unrelated
    // kernel-booting tests and the machine load cannot push it past the time limit.
    "minMsi": 100,
    "minCoveredMsi": 100
}
